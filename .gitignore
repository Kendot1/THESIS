# ============================================
# Dependencies
# ============================================
**/node_modules/
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ============================================
# Python
# ============================================
**/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.python-runtime/

# ============================================
# Next.js / React
# ============================================
**/.next/
**/.next-development/
**/.next-rolling-research/
/out/

# ============================================
# Build & Production
# ============================================
/build
/coverage

# ============================================
# Environment & Secrets
# ============================================
.env
.env*.local

# ============================================
# Logs
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
model_trainer/logs/*.log
.tmp/**/*.log
.tmp/**/*.json

# ============================================
# ML Artifacts & Training Output (large/generated)
# ============================================
model_trainer/artifacts/
model_trainer/artifacts_v2/
model_trainer/plots/

# ============================================
# Audit artifacts (generated snapshots & probes)
# ============================================
audits/**/training_snapshot.json
audits/**/live_quality_inputs.json
audits/**/*.log
audits/**/probe_artifacts/

# ============================================
# Temporary / tool-generated directories
# ============================================
.tmp/
/.tmp_pytests/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/graphify-out/
/ocr_temp/
.hermes-tmp.*
.codex/
.opencode/

# ============================================
# Supabase
# ============================================
supabase/.temp/

# ============================================
# IDE & Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# Test files and fixtures (existing tracked files remain tracked)
**/tests/
**/test_*.py
**/*_test.py
**/*.test.*
**/*.spec.*

# ============================================
# OS files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

