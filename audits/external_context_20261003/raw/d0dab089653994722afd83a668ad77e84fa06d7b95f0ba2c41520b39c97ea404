/* Turn each list item into a 2-column grid */
.rpwe-li {
    display: grid !important;
    grid-template-columns: 50px 1fr; /* left = thumbnail, right = text */
    grid-column-gap: 10px;
    align-items: start !important;
}

/* Stop RPWE from floating the thumbnail */
.rpwe-li .rpwe-alignleft,
.rpwe-li .rpwe-img,
.rpwe-li img.rpwe-thumb {
    float: none !important;
}

/* Make the thumbnail stay in the left column */
.rpwe-li .rpwe-img {
    grid-row: 1 / 3; /* span the full height of title + date */
}

/* Place the title in the top-right */
.rpwe-li h3.rpwe-title {
    grid-column: 2;
    grid-row: 1;
    margin: 0 !important;
}

/* Place the date UNDER the title in the right column */
.rpwe-li time.rpwe-time {
    grid-column: 2;
    grid-row: 2;
    display: block;
    margin-top: 3px;
}
</style>
